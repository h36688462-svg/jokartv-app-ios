default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Ensure App Store Connect API Key is used
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"] || ENV["APPSTORE_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"] || ENV["APPSTORE_ISSUER_ID"]
    priv_key = ENV["APP_STORE_CONNECT_API_PRIVATE_KEY"] || ENV["APPSTORE_PRIVATE_KEY"]

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: priv_key,
      is_key_content_base64: false
    )

    update_project_team(
      teamid: "5T6RH58JQ6",
      path: "Runner.xcodeproj"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_team_id: "5T6RH58JQ6",
      xcargs: "DEVELOPMENT_TEAM=5T6RH58JQ6 -allowProvisioningUpdates",
      skip_profile_detection: true
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  lane :release do
    beta
  end
end
